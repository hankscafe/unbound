# Copy to deploy/.env and edit. All variables are prefixed UNBOUND_.

# --- Security (IMPORTANT) --------------------------------------------------
# Master key for encrypting secrets at rest (Audible device tokens, etc.).
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# If left blank, a random key is generated and persisted to /data/secret.key.
UNBOUND_SECRET_KEY=

# Set false ONLY for plain-HTTP LAN testing (cookies won't set over http otherwise).
UNBOUND_COOKIE_SECURE=true

# --- Networking ------------------------------------------------------------
# Host port to expose the web UI on.
UNBOUND_HTTP_PORT=8080

# --- Library storage ---
# Host directory bind-mounted to /data/library in the container (decrypted books go here).
# Use an absolute path to your media/NAS directory in production, e.g. /mnt/media/audiobooks.
# It must exist and be writable by the container. Point your library profile's root at a
# path under /data/library (e.g. /data/library/audiobooks).
UNBOUND_LIBRARY_HOST_PATH=./library

# --- Pipeline --------------------------------------------------------------
UNBOUND_MAX_CONCURRENT_DOWNLOADS=2

# --- Update checks ---------------------------------------------------------
# Polls GitHub releases every 6h; admins get an in-app banner and (if enabled in
# Settings -> Notifications) an Apprise notification once per new version.
UNBOUND_UPDATE_CHECK_ENABLED=true
UNBOUND_GITHUB_REPO=hankscafe/unbound
# Only needed while the repo is private: a read-only personal access token so the
# release check can see releases. Leave blank for public repos.
UNBOUND_GITHUB_TOKEN=
